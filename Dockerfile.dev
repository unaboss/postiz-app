# syntax=docker/dockerfile:1

########## Stage 1 — build ##########
# Has the compilers and dev dependencies; none of this ships.
FROM node:22.20-bookworm-slim AS builder

ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
&& rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

WORKDIR /app
COPY . /app

RUN pnpm install
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# Everything except node_modules, as a single archive. The runtime stage must
# never contain the full dependency tree or the image keeps it in a layer.
RUN tar -czf /tmp/app-src.tgz --exclude=node_modules --exclude=.git -C /app .

########## Stage 2 — runtime ##########
# node, nginx, pnpm/pm2, the source + build output, and *only* production
# dependencies. No compilers, no dev dependencies, no full node_modules layer.
FROM node:22.20-bookworm-slim AS runner

ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY --from=builder /tmp/app-src.tgz /tmp/app-src.tgz
RUN tar -xzf /tmp/app-src.tgz -C /app && rm /tmp/app-src.tgz

# Production dependencies only, then the Prisma client. CI=true keeps pnpm from
# blocking on any interactive prompt inside the non-interactive build.
RUN CI=true pnpm install --prod --frozen-lockfile \
 && pnpm run prisma-generate \
 && npm cache clean --force

COPY var/docker/nginx.conf /etc/nginx/nginx.conf

CMD ["sh", "-c", "nginx && pnpm run pm2"]
